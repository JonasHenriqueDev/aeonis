#include <winver.h>

// Gerado pelo CMake (configure_file): versão do project().
IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/aeonis.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604b0"
        BEGIN
            VALUE "CompanyName", "Aeonis contributors"
            VALUE "FileDescription", "Aeonis - gravador de gameplay"
            VALUE "FileVersion", "@AEONIS_RELEASE_VERSION@"
            VALUE "InternalName", "Aeonis"
            VALUE "LegalCopyright", "GPL-3.0-or-later"
            VALUE "OriginalFilename", "Aeonis.exe"
            VALUE "ProductName", "Aeonis"
            VALUE "ProductVersion", "@AEONIS_RELEASE_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x416, 1200
    END
END
